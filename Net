    def on_tree_select(self, event):
        """Xử lý sự kiện chọn item trong Treeview (dùng <<TreeviewSelect>>)"""
        selection = self.file_tree.selection()
        if selection:
            item = selection[0]
            # Lấy index từ giá trị STT
            values = self.file_tree.item(item, 'values')
            try:
                self.selected_index = int(values[0]) - 1  # STT bắt đầu từ 1
            except (ValueError, IndexError):
                self.selected_index = None
        else:
            self.selected_index = None
    
    def add_file(self):
        """Thêm file"""
        file_paths = filedialog.askopenfilenames(
            title="Chọn file TXT",
            filetypes=[("Text files", "*.txt"), ("All files", "*.*")]
        )
        
        for file_path in file_paths:
            if file_path not in self.file_list:
                self.file_list.append(file_path)
        
        self.update_file_tree()
    
    def add_folder(self):
        """Thêm toàn bộ file từ thư mục"""
        folder_path = filedialog.askdirectory(title="Chọn thư mục")
        
        if folder_path:
            for file in os.listdir(folder_path):
                if file.endswith('.txt'):
                    file_path = os.path.join(folder_path, file)
                    if file_path not in self.file_list:
                        self.file_list.append(file_path)
            
            self.update_file_tree()
    
    def delete_selected_file(self):
        """Xóa file được chọn"""
        if self.selected_index is None:
            messagebox.showwarning("Cảnh báo", "Vui lòng chọn file muốn xóa!")
            return
        
        try:
            file_path = self.file_list[self.selected_index]
            file_name = os.path.basename(file_path)
            
            if messagebox.askyesno("Xác nhận", f"Bạn có chắc chắn muốn xóa file này?\n\n{file_name}"):
                self.file_list.pop(self.selected_index)
                self.selected_index = None
                self.update_file_tree()
                messagebox.showinfo("Thành công", f"Đã xóa: {file_name}")
        except Exception as e:
            messagebox.showerror("Lỗi", f"Không thể xóa file: {str(e)}")
    
    def clear_files(self):
        """Xóa tất cả file"""
        if self.file_list and messagebox.askyesno("Xác nhận", "Bạn có chắc chắn muốn xóa tất cả file?"):
            self.file_list.clear()
            self.selected_index = None
            self.update_file_tree()
            messagebox.showinfo("Thành công", "Đã xóa tất cả file khỏi danh sách!")
    
    def update_file_tree(self):
        """Cập nhật danh sách file trên giao diện"""
        # Xóa tất cả item cũ
        for item in self.file_tree.get_children():
            self.file_tree.delete(item)
        
        # Thêm item mới với đánh số thứ tự
        for i, file_path in enumerate(self.file_list):
            file_name = os.path.basename(file_path)
            stt = i + 1  # Đánh số từ 1
            
            # Phân biệt kiểu file dựa trên nội dung
            try:
                with open(file_path, 'r', encoding='utf-8') as f:
                    first_lines = [f.readline() for _ in range(30)]
                
                file_type = detect_file_type(first_lines)
                fmt = "ABAQUS" if file_type == "abaqus" else ("NASTRAN" if file_type == "nastran" else "Unknown")
            except Exception:
                fmt = "Unknown"
            
            # Thêm row vào Treeview
            self.file_tree.insert(
                "",
                tk.END,
                values=(stt, fmt, file_name, file_path)
            )
    
    def select_output_folder(self):
        """Chọn thư mục đầu ra"""
        folder_path = filedialog.askdirectory(title="Chọn thư mục lưu file")
        
        if folder_path:
            self.output_path = folder_path
            self.output_path_display.config(text=folder_path)
    
    def process_file(self, file_path, multiplier, output_dir):
        """Xử lý một file"""
        try:
            # Đọc file gốc
            with open(file_path, 'r', encoding='utf-8') as f:
                lines = f.readlines()
            
            # Nhận diện kiểu file
            file_type = detect_file_type(lines)
            
            # Xử lý theo kiểu file
            if file_type == "abaqus":
                modified_lines = [process_abaqus_line(line, multiplier) for line in lines]
            elif file_type == "nastran":
                modified_lines = process_nastran_lines(lines, multiplier)
            else:
                return False, "Không nhận diện được format", "unknown"
            
            # Tạo tên file mới
            base_name = os.path.splitext(os.path.basename(file_path))[0]
            new_file_name = base_name + "_modified.txt"
            new_file_path = os.path.join(output_dir, new_file_name)
            
            # Ghi file mới
            with open(new_file_path, 'w', encoding='utf-8') as f:
                f.writelines(modified_lines)
            
            return True, new_file_path, file_type
        except Exception as e:
            return False, str(e), "unknown"
    
    def process_files(self):
        """Xử lý tất cả file"""
        if not self.file_list:
            messagebox.showwarning("Cảnh báo", "Vui lòng chọn ít nhất một file!")
            return
        
        try:
            multiplier = float(self.multiplier_entry.get())
        except ValueError:
            messagebox.showerror("Lỗi", "Hệ số nhân phải là một số thực!")
            return
        
        # Xác định thư mục đầu ra
        if self.output_var.get() == "custom":
            if not self.output_path:
                messagebox.showwarning("Cảnh báo", "Vui lòng chọn thư mục đầu ra!")
                return
            output_dir = self.output_path
        else:
            output_dir = None
        
        # Chạy xử lý trên thread riêng để không làm đơ giao diện
        thread = threading.Thread(
            target=self._process_files_thread,
            args=(multiplier, output_dir)
        )
        thread.start()
    
    def _process_files_thread(self, multiplier, output_dir):
        """Xử lý file trên thread riêng"""
        self.processing = True
        self.process_btn.config(state=tk.DISABLED)
        self.log_text.delete(1.0, tk.END)
        
        total_files = len(self.file_list)
        successful = 0
        failed = 0
        
        self.log_message(f"Bắt đầu xử lý {total_files} file với hệ số nhân: {multiplier}\n")
        
        for i, file_path in enumerate(self.file_list, 1):
            # Cập nhật tiến trình
            progress = (i / total_files) * 100
            self.progress_var.set(progress)
            
            # Xác định thư mục đầu ra cho file này
            if output_dir is None:
                file_output_dir = os.path.dirname(file_path)
            else:
                file_output_dir = output_dir
            
            # Xử lý file
            file_name = os.path.basename(file_path)
            self.status_label.config(
                text=f"Đang xử lý ({i}/{total_files}): {file_name}",
                fg="#FF9800"
            )
            self.root.update()
            
            success, result, file_type = self.process_file(file_path, multiplier, file_output_dir)
            
            fmt = "ABAQUS" if file_type == "abaqus" else ("NASTRAN" if file_type == "nastran" else "???")
            
            if success:
                self.log_message(f"✓ [{i}/{total_files}] [{fmt}] {file_name} -> {os.path.basename(result)}")
                successful += 1
            else:
                self.log_message(f"✗ [{i}/{total_files}] {file_name} (Lỗi: {result})")
                failed += 1
        
        # Hoàn thành
        self.progress_var.set(100)
        self.log_message(f"\n{'='*70}")
        self.log_message(f"Hoàn thành! Thành công: {successful}, Thất bại: {failed}")
        self.status_label.config(
            text=f"Hoàn thành! ({successful} thành công, {failed} thất bại)",
            fg="#4CAF50"
        )
        
        self.process_btn.config(state=tk.NORMAL)
        self.processing = False
        
        messagebox.showinfo(
            "Hoàn thành",
            f"Xử lý hoàn thành!\n\nThành công: {successful}\nThất bại: {failed}"
        )
    
    def log_message(self, message):
        """Ghi log message"""
        self.log_text.insert(tk.END, message + "\n")
        self.log_text.see(tk.END)
        self.root.update()

