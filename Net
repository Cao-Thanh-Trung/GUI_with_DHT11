def detect_file_type(lines):
    """Nhận diện file bằng nội dung"""
    for l in lines[:50]:
        content = l.strip().upper()
        if '**' in content or "*STEP" in content or "*STATIC" in content or "*CLOAD" in content:
            return "abaqus"
        if content.startswith("$") or 'NASTRAN' in content or "BEGIN BULK" in content or "FORCE*" in content or "MOMENT*" in content:
            return "nastran"
    return "unknown"

def process_abaqus_line(line, multiplier):
    """Xử lý dòng ABAQUS: thay đổi giá trị thứ 3"""
    line = line.rstrip('\n')
    
    # Bỏ qua các dòng comment
    if line.startswith('*') or line.startswith('**'):
        return line + '\n'
    
    # Tách các phần của dòng
    parts = [p.strip() for p in line.split(',')]
    
    # Kiểm tra xem có đúng format không (node_id, dof, value)
    if len(parts) >= 3:
        try:
            # Lấy giá trị thứ 3
            value = float(parts[2])
            # Nhân với hệ số
            new_value = value * multiplier
            # Thay thế giá trị thứ 3
            parts[2] = f"{new_value:.5e}"
            # Ghép lại dòng
            return ','.join(parts) + '\n'
        except ValueError:
            pass
    
    return line + '\n'

def process_nastran_lines(lines, multiplier):
    """
    Xử lý dòng NASTRAN: sửa 3 giá trị số đầu tiên trên dòng * tiếp sau FORCE*/MOMENT*
    """
    result = []
    i = 0
    
    while i < len(lines):
        line = lines[i]
        line_upper = line.strip().upper()
        
        # Kiểm tra xem là dòng FORCE* hoặc MOMENT*
        if line_upper.startswith("FORCE*") or line_upper.startswith("MOMENT*"):
            result.append(line)
            i += 1
            
            # Dòng tiếp theo là dòng dữ liệu (bắt đầu bằng *)
            if i < len(lines):
                data_line = lines[i].rstrip('\n')
                
                # Bỏ dấu + ở cuối nếu có
                if data_line.endswith('+'):
                    data_line = data_line[:-1]
                
                # Trích xuất các giá trị số
                # Định dạng Nastran: các số ngăn cách bằng khoảng trắng
                parts = data_line.split()
                new_parts = []
                float_count = 0
                
                for part in parts:
                    try:
                        value = float(part)
                        float_count += 1
                        
                        # Chỉ nhân 3 giá trị đầu tiên
                        if float_count <= 3:
                            value = value * multiplier
                        
                        # Format lại với đủ độ chính xác
                        new_parts.append(f"{value:.8e}")
                    except ValueError:
                        new_parts.append(part)
                
                # Tái lập dòng dữ liệu
                new_data_line = " ".join(new_parts)
                
                # Thêm dấu + nếu cần (nếu dòng tiếp theo tiếp tục)
                if i + 1 < len(lines) and lines[i + 1].strip().startswith("*"):
                    new_data_line += " +"
                
                result.append(new_data_line + '\n')
                i += 1
                continue
        
        result.append(line)
        i += 1
    
    return result

